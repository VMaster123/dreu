# Ignore everything by default
*

# Explicitly allow the journal/template files
!.gitignore
!README.md
!TEMPLATE.md
!TEMPLATE_GDOC.md
!EXAMPLE.md
!check_log.py
!check_all.py
!config.ini.example
!students.csv

# Allow Research_Code directories
!Research_Code/
!Research_Code/**/

# Ignore generated/data/model files inside Research_Code
Research_Code/**/*.pt
Research_Code/**/*.pkl
Research_Code/**/*.csv
Research_Code/**/__pycache__/
Research_Code/**/*.pyc

# Allow Python source files
!Research_Code/**/*.py

# Allow desired result files
!Research_Code/**/results/
!Research_Code/**/results/**/*.json
!Research_Code/**/results/**/*.png

# Allow Notes
!Notes/
!Notes/**

# Allow logs
!logs/
!logs/**

# Allow GitHub Actions workflow
!.github/
!.github/workflows/
!.github/workflows/validate-log.yml